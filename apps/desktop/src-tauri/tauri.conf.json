{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Regards",
  "version": "0.3.0",
  "identifier": "app.regards.desktop",
  "build": {
    "beforeDevCommand": "cargo build -p regards-cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p regards-cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Regards",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost; frame-src regards-mail: http://regards-mail.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420; frame-src regards-mail: http://regards-mail.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0 OR MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyMzVGREZBOTVBQjAzNTMKUldSVEE2dVYrdjAxQWd6YzlsMkVuR2NabHZHUkRkdnRmbEwvN1IxTWQzWmRPZ21ObjZXY3U3blkK",
      "endpoints": [
        "https://github.com/lucienPochon/regards/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "regards"
        ]
      }
    }
  }
}
